# Never put real credentials in this file or git.
ENVIRONMENT=development
PORT=8000
# Durable PostgreSQL required on Vercel. Local development may use SQLite.
DATABASE_URL=
SQLITE_PATH=data.db
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:3000

# Native Gemini or the user's ai-seek service:
GEMINI_API_KEY=
AISEEK_ACCESS_TOKEN=
# ai-seek candidates are NOT an exhaustive discovery list.
# Gemini model discovery: owner POST /api/admin/models/refresh

# Optional OpenAI-compatible third-party service:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
FAST_MODEL=
STANDARD_MODEL=
ADVANCED_MODEL=

# Optional real search:
BRAVE_SEARCH_API_KEY=
# HTTPS retrieval is restricted to exact public hosts; no redirects.
ALLOWED_WEB_HOSTS=docs.python.org,developer.mozilla.org,en.wikipedia.org,github.com
