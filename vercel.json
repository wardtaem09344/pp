{
  "version": 2,
  "builds": [
    {"src": "api/index.py", "use": "@vercel/python", "config": {"maxLambdaSize": "50mb", "includeFiles": ["server/**", "app/**"]}},
    {"src": "app/**", "use": "@vercel/static"}
  ],
  "routes": [
    {"src": "/api/(.*)", "dest": "/api/index.py"},
    {"src": "/", "dest": "/app/index.html"},
    {"src": "/(.*)", "dest": "/app/$1"}
  ]
}
